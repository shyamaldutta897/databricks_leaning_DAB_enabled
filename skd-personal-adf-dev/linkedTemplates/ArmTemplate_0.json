{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "skd-personal-adf-dev"
		},
		"LS_AzureSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL'"
		},
		"LS_AzureSQL_metadb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_metadb'"
		},
		"LS_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_adls'"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "skd-personal-sql.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "skd_personal_sql_db"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sql_admin"
		},
		"LS_AzureSQL_metadb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "skd-personal-sql.database.windows.net"
		},
		"LS_AzureSQL_metadb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "meta_db"
		},
		"LS_AzureSQL_metadb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sql_admin"
		},
		"LS_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stgsdpersonaldev.dfs.core.windows.net/"
		},
		"LS_http_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://drive.google.com/uc?id=1zO8ekHWx9U7mrbx_0Hoxxu6od7uxJqWw&export=download"
		},
		"LS_http_github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
