{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "skd-personal-adf-dev"
		},
		"LS_AzureSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL'"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "skd-personal-sql.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "skd_personal_sql_db"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sql_admin"
		},
		"LS_AzureSQL_metadb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "skd-personal-sql.database.windows.net"
		},
		"LS_AzureSQL_metadb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "skd_personal_sql_db"
		},
		"LS_AzureSQL_metadb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sql_admin"
		},
		"LS_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stgsdpersonaldev.dfs.core.windows.net/"
		},
		"LS_http_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://drive.google.com/uc?id=1zO8ekHWx9U7mrbx_0Hoxxu6od7uxJqWw&export=download"
		},
		"LS_http_github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().base_url}"
		},
		"ls_http_dynamic_parameterized_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().base_url}"
		},
		"ls_kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvskdpersonal.vault.azure.net/"
		},
		"even_based_trigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/b37c5837-6d42-4738-813a-1005384a93fb/resourceGroups/rg_skd_personal_centralind/providers/Microsoft.Storage/storageAccounts/stgsdpersonaldev"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "skd-personal-adf-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureSQL_password": {
						"value": "[parameters('LS_AzureSQL_password')]"
					},
					"LS_AzureSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_userName')]"
					},
					"LS_http_properties_typeProperties_url": {
						"value": "[parameters('LS_http_properties_typeProperties_url')]"
					},
					"LS_http_github_properties_typeProperties_url": {
						"value": "[parameters('LS_http_github_properties_typeProperties_url')]"
					},
					"ls_http_dynamic_parameterized_properties_typeProperties_url": {
						"value": "[parameters('ls_http_dynamic_parameterized_properties_typeProperties_url')]"
					},
					"ls_kv_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_kv_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureSQL_metadb_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_metadb_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_metadb_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_metadb_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_metadb_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_metadb_properties_typeProperties_userName')]"
					},
					"LS_adls_properties_typeProperties_url": {
						"value": "[parameters('LS_adls_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "skd-personal-adf-dev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"even_based_trigger_properties_typeProperties_scope": {
						"value": "[parameters('even_based_trigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'skd-personal-adf-dev_ArmTemplate_0')]"
			]
		}
	]
}