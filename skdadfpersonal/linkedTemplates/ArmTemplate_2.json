{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "skdadfpersonal"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/6_logging_test_using_copy_activity_and_additional_columns')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Enabled two types of logging here - \ncopy activity -> setting -> enable logging\nWe need to provide a ls and a path\n\ncreate a new copy activity use an empty text file or json file --> additional columns --> dynamic content --> copy this file to a new location. It will register all the information that we have configured.\n\nImportant thing to keep in mind - when we use a json file, the file should have the minimum indication that it is a json file, so just put this expression - {}",
				"activities": [
					{
						"name": "copy a dummy file to enable logging",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false,
							"logSettings": {
								"enableCopyActivityLog": true,
								"copyActivityLogSettings": {
									"logLevel": "Warning",
									"enableReliableLogging": false
								},
								"logLocationSettings": {
									"linkedServiceName": {
										"referenceName": "LS_adls_new",
										"type": "LinkedServiceReference"
									},
									"path": "adfpipelines/copy_activity_logging"
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_city_state_json",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_city_state_destination",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					},
					{
						"name": "log copy data using additional columns",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "copy a dummy file to enable logging",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"additionalColumns": [
									{
										"name": "pipeline_id",
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										}
									},
									{
										"name": "pipeline_name",
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										}
									}
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_logging_json_file",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_json_logging_with_additional_columns",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"folder": {
					"name": "Interview_practice"
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/7_copy_only_those_files_which_dont_exist_in_target_location')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "1. Add a get metadata from source, list all childitems\n2. Repeat the same for sink location\n3. Add filter activity. It has items which is nothing but an iterating field. Meaning the array that we pass here will be iterated over. We'll pass the childlitems list of source metadata, because these values will be checked one by one against sink.\n4. Next in condition filed, we use a contains expression. Convert the array value of sink childitems array into a plain string separated by commas, for that reason we use the string function. Next pick each value from source and see if it exists in the string. If no then get the output.\n5. Next foreach activity to list the output and we pick only the value field from the output dict (output.value)\n6. Inside for each, setup a copy actvity and pass the file names as item().name.",
				"activities": [
					{
						"name": "Get childitems from source",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_adls_wo_filename",
								"type": "DatasetReference",
								"parameters": {
									"file_system": {
										"value": "landing",
										"type": "Expression"
									},
									"folder": {
										"value": "files",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "Get childitems from sink",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_adls_wo_filename",
								"type": "DatasetReference",
								"parameters": {
									"file_system": "adfpipelines",
									"folder": "files_copy"
								}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "filter files that exists in source but not in sink",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "Get childitems from sink",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Get childitems from source",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Get childitems from source').output.childItems",
								"type": "Expression"
							},
							"condition": {
								"value": "@not(contains(string(activity('Get childitems from sink').output.childItems),concat('\"',item().name,'\"')))",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Pick up output from filter",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "filter files that exists in source but not in sink",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('filter files that exists in source but not in sink').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Copy only those files that are not in sink",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "DelimitedTextSource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"wildcardFolderPath": "files",
												"wildcardFileName": "*",
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "DelimitedTextReadSettings"
											}
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_adls_only_folder_param",
											"type": "DatasetReference",
											"parameters": {
												"file_system": "landing",
												"folder_path": "files"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_parameterized_dynamic",
											"type": "DatasetReference",
											"parameters": {
												"destination_path": "files_copy",
												"file_name": {
													"value": "@item().name",
													"type": "Expression"
												},
												"file_system": "adfpipelines"
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"file_names": {
						"type": "Array"
					}
				},
				"folder": {
					"name": "Interview_practice"
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/8_copy_files_that_are_n_days_old')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "1. Get all childitems from a folder. We need only container and folder for this activity.\n2. Loop through the list of childitems\n3. Inside the loop activity add another metadata activity. In this activity we need filename as well, because we need last modified of each and every file.\n4. Add if condition. Check difference between the last modified date and current date. Explanation of the formula in the if activity.\n5. If true, then copy the files else do nothing.",
				"activities": [
					{
						"name": "get list of childitems in a folder",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_adls_only_folder_param",
								"type": "DatasetReference",
								"parameters": {
									"file_system": "landing",
									"folder_path": "files"
								}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "pick each file as output from get metadata",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "get list of childitems in a folder",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('get list of childitems in a folder').output.childItems",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "take file names as input",
									"description": "take file names as input from for each and fetch last modified",
									"type": "GetMetadata",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataset": {
											"referenceName": "ds_adls_parameterized_dynamic",
											"type": "DatasetReference",
											"parameters": {
												"destination_path": "files",
												"file_name": {
													"value": "@item().name",
													"type": "Expression"
												},
												"file_system": "landing"
											}
										},
										"fieldList": [
											"lastModified"
										],
										"storeSettings": {
											"type": "AzureBlobFSReadSettings",
											"recursive": true,
											"enablePartitionDiscovery": false
										},
										"formatSettings": {
											"type": "DelimitedTextReadSettings"
										}
									}
								},
								{
									"name": "check if last modified is less than n days",
									"description": "check if last modified is less than n days(pipeline param)\ngreaterOrEquals - Greater than or equal to\ndiv - divide\nsub - subtract\nticks - convert date value into int\n\nSo altogether - convert last modified and current date into int, subtract the values and divide by 864000000000 (number of seconds in 24 hours) to get the output in days.\n",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "take file names as input",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@greaterOrEquals(\n    div(sub(ticks(formatDateTime(utcNow(),'yyyy-MM-dd')), ticks(formatDateTime(activity('take file names as input').output.lastModified,'yyyy-MM-dd'))), 864000000000), \n    pipeline().parameters.days_old\n)",
											"type": "Expression"
										},
										"ifTrueActivities": [
											{
												"name": "copy files that are older than n days",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "DelimitedTextSource",
														"storeSettings": {
															"type": "AzureBlobFSReadSettings",
															"recursive": false,
															"wildcardFolderPath": "files",
															"wildcardFileName": "*",
															"enablePartitionDiscovery": false
														},
														"formatSettings": {
															"type": "DelimitedTextReadSettings"
														}
													},
													"sink": {
														"type": "DelimitedTextSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "DelimitedTextWriteSettings",
															"quoteAllText": true,
															"fileExtension": ".txt"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "ds_adls_only_folder_param",
														"type": "DatasetReference",
														"parameters": {
															"file_system": "landing",
															"folder_path": "files"
														}
													}
												],
												"outputs": [
													{
														"referenceName": "ds_adls_only_folder_param",
														"type": "DatasetReference",
														"parameters": {
															"file_system": "adfpipelines",
															"folder_path": "old_files"
														}
													}
												]
											}
										]
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"days_old": {
						"type": "int"
					}
				},
				"variables": {
					"file_names": {
						"type": "Array"
					}
				},
				"folder": {
					"name": "Interview_practice"
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/CopyFromADLSToSQL')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Validate if the file exists",
						"type": "Validation",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_customers_csv2",
								"type": "DatasetReference",
								"parameters": {}
							},
							"timeout": "0.00:01:00",
							"sleep": 10
						}
					},
					{
						"name": "Check if the file exists and column count matches",
						"type": "GetMetadata",
						"dependsOn": [
							{
								"activity": "Validate if the file exists",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_customers_csv2",
								"type": "DatasetReference",
								"parameters": {}
							},
							"fieldList": [
								"exists",
								"columnCount",
								"itemType"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "check if file exists and column count matches",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Check if the file exists and column count matches",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@and(activity('Check if the file exists and column count matches').output.exists, equals(activity('Check if the file exists and column count matches').output.columnCount,11))",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "If the condition fails",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "Data copy has failed, check source files.",
										"errorCode": "666"
									}
								}
							],
							"ifTrueActivities": [
								{
									"name": "Copy from ADLS to SQL",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "DelimitedTextSource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "DelimitedTextReadSettings"
											}
										},
										"sink": {
											"type": "AzureSqlSink",
											"writeBehavior": "upsert",
											"upsertSettings": {
												"useTempDB": true,
												"keys": [
													"Customer Id"
												]
											},
											"sqlWriterUseTableLock": false,
											"disableMetricsCollection": false
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_customers_csv2",
											"type": "DatasetReference",
											"parameters": {}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_customers_upsert",
											"type": "DatasetReference",
											"parameters": {}
										}
									]
								},
								{
									"name": "Delete if copy is successful",
									"type": "Delete",
									"dependsOn": [
										{
											"activity": "Copy from ADLS to SQL",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
