		{
			"name": "[concat(parameters('factoryName'), '/CleanDataFromADLS')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_customers_csv",
								"type": "DatasetReference"
							},
							"name": "adlscustomers"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_customer_count_aggregated",
								"type": "DatasetReference"
							},
							"name": "customersaggregated"
						},
						{
							"dataset": {
								"referenceName": "ds_customer_data_raw",
								"type": "DatasetReference"
							},
							"name": "customerrawdata"
						}
					],
					"transformations": [
						{
							"name": "selectcolumns"
						},
						{
							"name": "concatnames"
						},
						{
							"name": "customercountbycountry"
						},
						{
							"name": "keepfields"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Index as string,",
						"          {Customer Id} as string,",
						"          {First Name} as string,",
						"          {Last Name} as string,",
						"          Company as string,",
						"          City as string,",
						"          Country as string,",
						"          {Phone 1} as string,",
						"          {Phone 2} as string,",
						"          Email as string,",
						"          {Subscription Date} as string,",
						"          Website as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('roundRobin', 2)) ~> adlscustomers",
						"adlscustomers select(mapColumn(",
						"          Index,",
						"          {Customer Id},",
						"          {First Name},",
						"          {Last Name},",
						"          Company,",
						"          City,",
						"          Country,",
						"          {Phone 1},",
						"          Email,",
						"          {Subscription Date},",
						"          Website",
						"     ),",
						"     partitionBy('roundRobin', 2),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectcolumns",
						"selectcolumns derive({Full name} = concat({First Name},' ',{Last Name})) ~> concatnames",
						"selectcolumns aggregate(groupBy(Country),",
						"     {customer count} = count({Customer Id})) ~> customercountbycountry",
						"concatnames select(mapColumn(",
						"          Index,",
						"          {Customer Id},",
						"          {Full name},",
						"          Company,",
						"          City,",
						"          Country,",
						"          {Phone 1},",
						"          Email,",
						"          {Subscription Date},",
						"          Website",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> keepfields",
						"customercountbycountry sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> customersaggregated",
						"keepfields sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          {Index     Customer Id     First Name     Last Name     Company     City     Country     Phone 1     Phone 2     Email     Subscription Date     Website} as string",
						"     ),",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> customerrawdata"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/metadata_based_dataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls_parameterized_dynamic",
								"type": "DatasetReference"
							},
							"name": "dynamicsourceformultipledatastreams"
						}
					],
					"sinks": [
						{
							"name": "sink1"
						},
						{
							"name": "sink2"
						},
						{
							"name": "sink3"
						}
					],
					"transformations": [
						{
							"name": "split1"
						},
						{
							"name": "aggregate1"
						},
						{
							"name": "join1"
						},
						{
							"name": "split2"
						},
						{
							"name": "select1"
						},
						{
							"name": "select2"
						},
						{
							"name": "select3"
						}
					],
					"scriptLines": [
						"source(output(",
						"          order_id as string,",
						"          order_date as string,",
						"          customer_id as string,",
						"          order_status as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     rowUrlColumn: ('source_file_name')) ~> dynamicsourceformultipledatastreams",
						"dynamicsourceformultipledatastreams split(instr(byName('source_file_name'),'orders.csv')>0,",
						"     instr(byName('source_file_name'),'order_items.csv')>0,",
						"     disjoint: false) ~> split1@(orders, orderitems, invalid)",
						"split1@orderitems aggregate(groupBy(order_id = toString(byName('order_id'))),",
						"     total_amount = sum(toDecimal(byName('total_amount')))) ~> aggregate1",
						"split1@orders, aggregate1 join(split1@orders@order_id == aggregate1@order_id,",
						"     joinType:'outer',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join1",
						"join1 split(total_amount>=500,",
						"     total_amount<500,",
						"     disjoint: false) ~> split2@(morethan500, lessthan500, nomatch)",
						"split2@morethan500 select(mapColumn(",
						"          order_id = split2@morethan500@order_id,",
						"          order_date,",
						"          customer_id,",
						"          order_status,",
						"          total_amount",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"split2@lessthan500 select(mapColumn(",
						"          order_id = split2@lessthan500@order_id,",
						"          order_date,",
						"          customer_id,",
						"          order_status,",
						"          total_amount",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select2",
						"split2@nomatch select(mapColumn(",
						"          order_id = split2@nomatch@order_id,",
						"          order_date,",
						"          customer_id,",
						"          order_status,",
						"          total_amount",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select3",
						"select1 sink(validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     store: 'cache',",
						"     format: 'inline',",
						"     output: false,",
						"     saveOrder: 1) ~> sink1",
						"select2 sink(validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     store: 'cache',",
						"     format: 'inline',",
						"     output: false,",
						"     saveOrder: 1) ~> sink2",
						"select3 sink(validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     store: 'cache',",
						"     format: 'inline',",
						"     output: false,",
						"     saveOrder: 1) ~> sink3"
					]
				}
			},
			"dependsOn": []
		},
