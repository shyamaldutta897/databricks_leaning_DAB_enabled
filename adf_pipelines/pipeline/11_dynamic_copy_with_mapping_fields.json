{
	"name": "11_dynamic_copy_with_mapping_fields",
	"properties": {
		"description": "This pipeline is about copying multiple files with mapping schemas activated. Basically whenever we activate mapping schema, all files coming through that copy activity has to be of same schema. But here requirement is to copy multiple files with different schemas but also keep in consideration that this is a schema based mapping. Basically if we want to update schema (fieldnames, types etc) while copying we can use this approach.\n\n1. First get all the files into the copy activity and import schema. Then go to the copy activity source code and copy the entire json portion of mapping section.\n2. Then create a pipeline parameter and push this json part as an object. We can update field names here as well. If there are multiple files then there can be multiple pipeline parameters with multiple schemas with each schema pointed to one file.\n3. Get a getmetadata activity and get the file names\n4. Push them into a for each activity\n5. Push the copy activity inside the for each activity and pass the file names to copy one by one.\n6. In the copy activity, under mapping section remove all the mapping and then activate a dynamic mapping - basically an if condtition based on the filenames and which schema to pick accordingly. \n\nThis method is good when the number of files are limited. If the number increase then we need to go for metadata based approach.\n\nRefer to chatgpt if this description is confusing. Copy the json of this pipeline and feed into it.",
		"activities": [
			{
				"name": "Loop over the files list",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get filenames",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get filenames').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "copy data with mapping fields",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"value": "@if(contains(item().name, 'customers'), pipeline().parameters.p_map_1, pipeline().parameters.p_map_2)",
									"type": "Expression"
								}
							},
							"inputs": [
								{
									"referenceName": "ds_adls_parameterized_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"destination_path": "mapping_copy",
										"file_name": {
											"value": "@item().name",
											"type": "Expression"
										},
										"file_system": "landing"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_parameterized_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"destination_path": "files",
										"file_name": {
											"value": "@item().name",
											"type": "Expression"
										},
										"file_system": "bronze"
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "get filenames",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_adls_only_folder_param",
						"type": "DatasetReference",
						"parameters": {
							"file_system": "landing",
							"folder_path": "mapping_copy"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
