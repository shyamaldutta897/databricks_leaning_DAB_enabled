{
	"name": "10_get_secrets_from_key_vault_dynamic",
	"properties": {
		"description": "This pipeline is exactly same as sl no 9, except this is more dynamic and accepts parameter in places of hardcoded values in the URI. Rest everything remains the same.",
		"activities": [
			{
				"name": "connect to key vault",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "https://@{pipeline().parameters.p_kv_name}.vault.azure.net/secrets/@{pipeline().parameters.p_key_details}?api-version=7.5",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "get the secret value",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "connect to key vault",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "var_secret_value",
					"value": {
						"value": "@activity('connect to key vault').output.value",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_kv_name": {
				"type": "string",
				"defaultValue": "kvskdpersonalnew"
			},
			"p_key_details": {
				"type": "string",
				"defaultValue": "adls-key/fe8304ac93de447690a1c4d61c374003"
			}
		},
		"variables": {
			"var_secret_value": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Interview_practice"
		},
		"annotations": []
	}
}