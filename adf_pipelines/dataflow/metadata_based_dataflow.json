{
	"name": "metadata_based_dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_parameterized_dynamic",
						"type": "DatasetReference"
					},
					"name": "dynamicsourceformultipledatastreams"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          order_date as string,",
				"          customer_id as string,",
				"          order_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     rowUrlColumn: ('source_file_name')) ~> dynamicsourceformultipledatastreams",
				"dynamicsourceformultipledatastreams split(instr('source_file_name','orders.csv')>0,",
				"     instr('source_file_name','order_items.csv')>0,",
				"     disjoint: false) ~> split1@(orders, orderitems, invalid)"
			]
		}
	}
}