{
	"name": "metadata_based_dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_parameterized_dynamic",
						"type": "DatasetReference"
					},
					"name": "dynamicsourceformultipledatastreams"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     df_entity_name as string",
				"}",
				"source(output(",
				"          order_id as integer,",
				"          order_date as string,",
				"          customer_id as integer,",
				"          order_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dynamicsourceformultipledatastreams",
				"dynamicsourceformultipledatastreams split($df_entity_name=='orders',",
				"     $df_entity_name=='order_items',",
				"     disjoint: false) ~> split1@(orders, order_items, invalid)"
			]
		}
	}
}